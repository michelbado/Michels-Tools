# Michel's Tools: which tools to offer.
#
# Copy this file to  tools.conf  next to the program (or point to any file with  -tools-config /path/to/file),
# then restart the service. One "name = true" or "name = false" per line; "#" starts a comment.
# A tool you do not list is ON. If there is no tools.conf at all, everything is on.
#
# A tool that is off is gone completely: no icon, no menu entry, and its files and API answer "404 Not Found".
# A folder whose tools are all off disappears too. If a folder says false, every tool inside it is off,
# whatever the tool's own line says.
# A misspelled name stops the program at startup with the line number, so a typo can never leave a tool on by accident.

# ---- Folders (switch off a whole group) ----
network = true
pdf = true
trouble = true
certs = true
engineering = true
builders = true
images = true
reference = true
games = true

# ---- Network Tools ----
aggregator = true      # IP Aggregator (also switches off its server API, POST /api/aggregate)
subnet = true          # Subnet Calculator
splitter = true        # Subnet Splitter
checker = true         # IP Checker
ipv6calc = true        # IPv6 Calculator (addresses, prefixes, address types, splitting, reverse DNS names)
ipconv = true          # IP & Number Converter (decimal, hex, binary, reverse DNS, unusual forms)
maclookup = true       # MAC Lookup (manufacturer from the IEEE list, address formats, random-address check)
mailhdr = true         # Email Header Analyser (route, delays, SPF/DKIM/DMARC, forged-sender hints)
mailauth = true       # SPF, DKIM & DMARC Reader (explains pasted DNS records and finds mistakes; nothing is looked up)
mtucalc = true         # MTU & MSS Calculator (largest packet through PPPoE, GRE, IPsec, WireGuard, VXLAN ...; TCP MSS to set)
cgnat = true           # CGNAT Port Calculator (port blocks per subscriber, who was behind a public address and port, pool sizing; read in the browser)
dhcpopt = true         # DHCP Option Helper (build and read DHCP options such as 43, 82, 119, 121; whole messages; server configuration lines)

# ---- PDF Tools (all of these run in the visitor's browser; nothing is uploaded) ----
pdfinfo = true         # PDF Info
pdfverify = true       # Verify Signatures
pdfmeta = true         # Metadata
pdfstamp = true        # Add Image / Signature (not a digital signature)
pdfwatermark = true    # Watermark & Page Numbers
pdfpages = true        # Split / Extract Pages
pdfmerge = true        # Merge PDFs
pdforganize = true     # Organize Pages
pdfcrop = true         # Crop / Resize Pages
pdfredact = true       # Redact (black out parts of a PDF for good: pages with boxes become pictures)
pdfimages = true       # Images / PDF Converter
pdfextract = true      # Extract Content

# ---- Troubleshooting ----
netquality = true      # Connection Quality (latency, speed and stability of the link to this server)
connfacts = true      # Connection Facts (what the site sees of the visitor: address, CDN, protocol, clock, time breakdown)
idletest = true       # Idle-timeout finder (how long the path lets a quiet connection live; holds a request open on the server)
pathread = true       # Ping & Traceroute Reader (paste the output of ping, tracert, traceroute, mtr, pathping; read in the browser)
browsercaps = true     # Browser Capability Report (what this browser can do; read in the browser)
httphdr = true         # HTTP Header Reader (paste response headers: security headers, cookies, caching, CORS; read in the browser)
pktdecode = true      # Packet Header Decoder (paste the hex of a packet: every header named, checksums checked; read in the browser)
tputcalc = true        # Throughput Calculator (what limits a TCP connection, transfer time, share of the line that is data, packets per second, data per month)

# ---- Certificates (all of these run in the visitor's browser; nothing added, pasted or opened is sent anywhere; private keys are handled in memory only) ----
certcheck = true       # Certificate Package Checker (drop certificate, key, CA bundle, PFX, CSR: one verdict on match, chain, dates, names, strength)
certconvert = true     # Certificate Converter (PEM, DER, PFX with or without a password, P7B, key formats, ready files for nginx, Apache, IIS, Tomcat, HAProxy)
certcsr = true         # CSR & Key Generator (new key and certificate request made in the browser; needs https)
certdecode = true      # Certificate Decoder (reads certificates, chains and CSRs; refuses private keys)
opensslhelp = true     # OpenSSL Command Helper (the exact openssl command for each task, with explanations; runs nothing)
sshkey = true          # SSH Key Inspector (fingerprints, size, certificates, authorized_keys and known_hosts lines; read in the browser)

# ---- Engineering Tools (all of these run in the visitor's browser; nothing typed or pasted is sent anywhere) ----
urlparse = true        # URL Parser (scheme, user, password, host, port, path, every query parameter; spots look-alike and hidden addresses)
jwtdecode = true       # JWT Decoder (header, payload, times; optional signature check with a public key or secret)
basicauth = true       # Basic Auth Generator (makes and reads the Authorization: Basic header)
xmljson = true         # XML & JSON Converter (both directions, with a stated convention)
crontab = true         # Crontab Generator (plain-words explanation and next run times of a cron expression)
chmodcalc = true       # chmod Calculator (permissions as octal, letters and commands; umask)
colorconv = true       # Color Converter (name, hex, rgb, hsl, hwb; nearest CSS name; contrast)
jsonfmt = true         # JSON Formatter & Validator (exact formatting, exact error position, repair, path lookup)
textdiff = true        # Text Compare (line and word differences, unified diff)
encodetool = true      # Base64 & URL Encoder (Base64, URL, hex, HTML entities, \u escapes)
hashcalc = true        # Hash & Checksum (MD5, SHA, CRC, HMAC; text or file; compare with a given hash)
timeconv = true        # Timestamp Converter (Unix time, dates, time zones, Windows/.NET/Excel/Apple epochs)
passgen = true         # Password & UUID Generator (random passwords, UUID v4/v7, ULID, tokens)
regextest = true       # Regex Tester (JavaScript regular expressions with a time limit)
qrcode = true          # QR Code Maker & Reader (Wi-Fi, e-mail, contact and text codes; reads pictures)

# ---- Image Tools (these run in the visitor's browser; no picture is uploaded) ----
imgexif = true         # Photo Info & Privacy (read, edit and remove hidden camera data such as location; JPEG, PNG, WebP)
imgresize = true       # Resize / Crop (crop, rotate, resize, save as JPEG, PNG or WebP)
imgblur = true         # Blur / Redact (pixelate, blur or black out parts of a picture)
imgconvert = true      # Convert & Compress (JPEG, PNG, WebP; quality or "smaller than N KB")
imgwatermark = true    # Watermark (text or logo on a picture)
imgbatch = true        # Batch Pictures (resize, convert, remove hidden data or mark many pictures; one ZIP)
imgfavicon = true      # Favicon & Icon Generator (favicon.ico, PNG sizes, manifest, HTML lines; one ZIP)
imgannotate = true      # Screenshot Annotator (arrows, boxes, numbered steps, text, highlights, hidden areas; read in the browser)

# ---- Reference (look-up tables; they run in the visitor's browser and cost the server nothing) ----
portref = true         # Port Reference (what a port number is used for, which ones are risky)
dscp = true            # DSCP & QoS Values (code points, ToS bytes, typical uses)
httpstatus = true      # HTTP Status Codes (meaning and usual causes)
dnstypes = true        # DNS Record Types (what each is for, with examples)
icmptypes = true       # ICMP Types (IPv4 and IPv6, with firewall advice)
tcpref = true          # TCP Reference (flags, connection states, options)
ipsecref = true        # IPsec Reference (DH groups, matching strengths, algorithms, ports and terms)

# ---- Games (they run in the visitor's browser and cost the server nothing; scores stay in the visitor's browser; sound is off until switched on) ----
blocks = true          # Blocks (falling pieces; fill a row to clear it)
mines = true           # Mines (open every square that hides no mine; three sizes)
pinball = true         # Pinball (one table, three balls)
racer = true           # Road Racer (arcade driving against the clock)
pool = true            # Pool (8-ball against the computer or a second player on the same screen)
birdhunt = true        # Bird Hunt (birds burst out of the grass; three shots for each flight)
stunt = true           # Stunt Track (3D stunt driving against the clock: loops, jumps, a track editor)
gemmaze = true         # Gem Maze (puzzle levels: keys, doors, crates, ice, conveyors, creatures)

# ---- Command Builders (they build text such as command lines; nothing is run, and nothing is sent anywhere) ----
tcpdump = true         # tcpdump & Wireshark Filters (build a capture filter from choices, read one in plain words, Wireshark equivalent, command lines, recipes)
nmap = true             # nmap Command Builder (choices in, one explained nmap command out; nothing is scanned)
sshtunnel = true       # SSH Tunnel Builder (port forwards, SOCKS proxy, jump hosts; ssh command, config block, autossh, systemd unit)
curlconv = true        # curl Converter (a curl command as JavaScript fetch, Python requests, Go and PowerShell)
iproute = true         # iproute2 Command Builder (addresses, VLANs, bridges, tunnels, routes, policy routing, with the undo commands)
nftables = true        # nftables Firewall Builder (a ruleset for a server or small router: services, sources, rate limits, NAT, port forwards)
systemdunit = true     # systemd Service & Timer Builder (a service, an optional timer, and the commands to install and check them)

# ---- Locking ----
# Instead of "true" or "false", a tool or a whole folder can say "locked": it stays visible, but its files and server calls are refused until the
# visitor has entered the access code below (they click the tool, a small window asks for the code). One code for all locked tools. Example:
#     qrcode = locked
#     pdf = locked          (every tool in the PDF folder)
# A locked tool whose code is missing stops the program at startup, so a tool can never end up open by mistake. A tool that is switched off stays off.
# The access code (a PIN or a password): at least 4 characters, and the longer the safer, may contain spaces and #. Because of that, NO comment may follow it on its own line. Empty: nothing may be locked.
lock.code =
# How long an entered code stays valid in the visitor's browser, 1 to 168 hours (changing the code logs everybody out at once):
lock.hours = 12

# ---- Settings (tool.setting = value). The values below are the defaults. ----
# Connection Quality has a Monitor mode: it keeps probing the link until the visitor presses Stop. It keeps one connection busy
# for minutes, so you can limit it:
netquality.monitor = true            # offer Monitor mode at all (false: only the 30-second quick test)
netquality.monitor_exclusive = true  # only ONE visitor may monitor at a time; for everyone else the option is greyed out until they press Stop
netquality.monitor_minutes = 10      # the longest a monitoring run may last, 1 to 60
netquality.monitor_fine = true       # allow "fine detail" (20 probes a second instead of 5) in Monitor mode; it catches 50 ms hiccups but sends 4x the requests
# The Idle-timeout finder asks the server to hold a request open without sending anything. It also keeps at most 4 such tests per visitor and 40 on the whole server:
idletest.max_seconds = 300           # the longest a single held request may last, 30 to 600 (Cloudflare gives up after 100, many load balancers after 60)
# The visit log (IP address and browser type of each visit) may take at most this much disk, in MB (1024 = 1 GB). When it grows past it, the oldest days are deleted first. 0 = no limit:
log.max_mb = 1024
